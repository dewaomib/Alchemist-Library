# =============================================================================
# The Grand Alchemist's Archive - Supabase Environment Configuration
# =============================================================================
# Copy this file to .env and insert your real Supabase project credentials.
# If these variables are empty or not configured, the app will automatically
# and seamlessly run in "Local Grimoire Mode" without throwing any errors.

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
